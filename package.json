{
  "name": "hidden-spots-app",
  "version": "1.0.0",
  "description": "Hidden Spots App - React Native with Node.js backend",
  "main": "server/index.js",
  "scripts": {
    "start": "cd server && npm start",
    "server": "cd server && npm start",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "keywords": ["react-native", "expo", "nodejs", "express", "mongodb"],
